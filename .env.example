# ─────────────────────────────────────────────────────────────────────────────
# Foundry / Deployment — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in for local deployment scripts.
# NEVER commit .env — it is in .gitignore.
# NEVER prefix deployment secrets with VITE_ — they must NEVER reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Deployer private key — NEVER share or commit this value
PRIVATE_KEY=

# Bohr Testnet RPC (used by foundry.toml [rpc_endpoints])
BOHR_RPC_URL=https://rpc.bohr.life

