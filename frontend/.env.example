# ─────────────────────────────────────────────────────────────────────────────
# StudentPay Frontend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
#
# VITE_* variables are SAFE to expose to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Reown (WalletConnect) project ID — get yours at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=

# Bohr Testnet RPC endpoint (default is the public one)
VITE_BOHR_RPC_URL=https://rpc.bohr.life

# Bohr Testnet Chain ID
VITE_BOHR_CHAIN_ID=968

# Deployed escrow contract address — populate after deployment
VITE_ESCROW_CONTRACT_ADDRESS=

